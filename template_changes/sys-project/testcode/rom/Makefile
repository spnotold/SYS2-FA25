TESTCASE_SOURCE := $(wildcard *.S)
TESTCASE_ELF := $(TESTCASE_SOURCE:.S=.elf)
TESTCASE_ASM := $(TESTCASE_SOURCE:.S=.asm)
TESTCASE_HEX := $(TESTCASE_SOURCE:.S=.hex)
TESTCASE_OBJ := $(TESTCASE_SOURCE:.S=.o)

all:
	$(RISCV_GCC) $(RISCV_GCC_OPTS) -Tlink.ld $(TESTCASE_SOURCE) -o $(TESTCASE_ELF)
	$(RISCV_GCC) $(RISCV_GCC_OPTS) -c $(TESTCASE_SOURCE)
	$(RISCV_OBJDUMP) $(TESTCASE_ELF) > $(TESTCASE_ASM)
	$(RISCV_OBJCOPY) $(TESTCASE_ELF) tmp
	od -w8 -vAn -tx8 tmp > $(TESTCASE_HEX)
	rm -f tmp

clean:
	rm -f $(TESTCASE_ELF) $(TESTCASE_ASM) $(TESTCASE_HEX) $(TESTCASE_OBJ)
